
#include <stdio.h>
#include <stdlib.h>
#include <string.h>

#define FILE_NAME "student_records.txt"

int main() {
    FILE *file;
    char name[100];
    char age[20];
    char course[100];
    char line[250];
    int students;
    int i;

    printf("Writing Student Database:\n");

    printf("How many students do you want to record? ");
    scanf("%d", &students);
    getchar();

    if (students <= 0) {
        printf("Invalid number of students.\n");
        return 1;
    }

    file = fopen(FILE_NAME, "w");

    if (file == NULL) {
        printf("Error creating file.\n");
        return 1;
    }

    for (i = 1; i <= students; i++) {

        printf("\nStudent %d\n", i);

        printf("Enter Name: ");
        fgets(name, sizeof(name), stdin);
        name[strcspn(name, "\n")] = '\0';

        printf("Enter Age: ");
        fgets(age, sizeof(age), stdin);
        age[strcspn(age, "\n")] = '\0';

        printf("Enter Course: ");
        fgets(course, sizeof(course), stdin);
        course[strcspn(course, "\n")] = '\0';

        fprintf(file, "Student %d\n", i);
        fprintf(file, "Name: %s\n", name);
        fprintf(file, "Age: %s\n", age);
        fprintf(file, "Course: %s\n", course);
        fprintf(file, "--------------------\n\n");
    }

    fclose(file);

    printf("\nStudent database successfully saved to file.\n");

    file = fopen(FILE_NAME, "r");

    if (file == NULL) {
        printf("Error opening file.\n");
        return 1;
    }

    printf("\nReading Student Database:\n\n");

    while (fgets(line, sizeof(line), file) != NULL) {
        printf("%s", line);
    }

    fclose(file);

    return 0;
}
